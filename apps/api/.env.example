AUTH_LOGIN_WINDOW_SECONDS=900
COOKIE_SECURE=false
BOOTSTRAP_ATTENDANT_EMAIL=
BOOTSTRAP_ATTENDANT_PASSWORD=
FILE_STORAGE_ROOT=./uploads
PDF_MAX_BYTES=10485760
PDF_MAX_PAGES=100
ARTICLE_MAX_CHARACTERS=100000
