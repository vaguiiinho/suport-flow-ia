{
  "name": "@support-flow/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "test": "node --import tsx --test src/health.spec.ts src/ingestion/chunker.spec.ts src/ingestion/ingestion-worker.spec.ts src/infrastructure/openai-embedding-provider.spec.ts",
    "test:integration": "node --import tsx --test src/ingestion/postgres-ingestion.integration.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@support-flow/shared": "*",
    "dotenv": "^17.2.3",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/pg": "^8.16.0",
    "tsx": "^4.21.0"
  }
}
