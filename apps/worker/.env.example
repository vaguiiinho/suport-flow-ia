WORKER_PORT=3002
DATABASE_URL=postgresql://support_flow:change-me@localhost:5432/support_flow?schema=public
WORKER_ID=worker-local
INGESTION_POLL_INTERVAL_MS=2000
INGESTION_CLAIM_TIMEOUT_MS=120000
INGESTION_MAX_ATTEMPTS=3
INGESTION_RETRY_BASE_MS=5000
INGESTION_EMBEDDING_BATCH_SIZE=32
INGESTION_CHUNK_MAX_CHARACTERS=1200
INGESTION_CHUNK_OVERLAP_CHARACTERS=200
# Must point to the same directory used by the API (apps/api/uploads when both run locally).
FILE_STORAGE_ROOT=../api/uploads
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_TIMEOUT_MS=30000
